                "svg": "<svg width=\"388\" height=\"50\"><text font-family=\"TypeWriter\" font-size=\"10.0\" font-weight=\"bold\" fill=\"#000000\" fill-opacity=\"1.0\">Static route:\nip route&lt;network tujuan&gt; &lt;subnet tujuan&gt;</text></svg>",
