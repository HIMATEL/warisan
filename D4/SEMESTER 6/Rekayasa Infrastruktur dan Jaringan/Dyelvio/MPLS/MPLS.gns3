            {
                "drawing_id": "35f2a571-61c8-41b9-900d-71eaf047088d",
                "locked": false,
                "rotation": 0,
                "svg": "<svg width=\"486\" height=\"848\"><text font-family=\"TypeWriter\" font-size=\"10.0\" font-weight=\"bold\" fill=\"#000000\" fill-opacity=\"1.0\">R1\nint l0\nip add 1.1.1.1 255.255.255.255\nip ospf 123 area 0\nno sh\n\nint e0/0\nip add 12.12.12.1 255.255.255.252\nip ospf 123 area 0\nno sh\n\n&lt;konfigurasi ldp sebagai aktifasi fungsi MPLS Domain&gt;\nrouter ospf 123\nmpls ldp autoconfig\n\n&lt;konfigurasi MP-BGP&gt;\nrouter bgp 123\nneighbor 3.3.3.3 remote-as 123\nneighbor 3.3.3.3 update-source l0\nno auto-summary\n\naddress-family vpnv4\nneighbor 3.3.3.3 activate\n\nint s2/1\nip add 41.41.41.2 255.255.255.252\nno sh\n\n&lt;konfigurasi VPN&gt;\nip cef\nip vrf RED\nrd 45:4\nroute-target export 45:4\nroute-target import 45:5\n\nint s2/1\nip vrf forwarding RED\nip add 41.41.41.2 255.255.255.252\nip ospf 45 area 2\nno sh</text></svg>",
                "x": -946,
                "y": -380,
                "z": 2
            },
            {
                "drawing_id": "f50a249a-bc57-47d1-ba81-9cf4facff620",
                "locked": false,
                "rotation": 0,
                "svg": "<svg width=\"310\" height=\"554\"><text font-family=\"TypeWriter\" font-size=\"10.0\" font-weight=\"bold\" fill=\"#000000\" fill-opacity=\"1.0\">R2\nint l0\nip add 3.3.3.3 255.255.255.255\nip ospf 123 area 0\nno sh\n\nint e0/0\nip add 23.23.23.2 255.255.255.252\nip ospf 123 area 0\nno sh\n\nrouter ospf 123\nmpls ldp autoconfig\n\nrouter bgp 123\nneighbor 1.1.1.1 remote-as 123\nneighbor 1.1.1.1 update-source l0\nno auto-summary\n\naddress-family vpnv4\nneighbor 1.1.1.1 activate\n\nint s2/0\nip add 35.35.35.1 255.255.255.252\nip ospf 45 area 2\nno sh</text></svg>",
                "x": -28,
                "y": -99,
                "z": 2
            },
            {
                "drawing_id": "cf5c8a16-2740-4a23-bed9-f8f386d91770",
