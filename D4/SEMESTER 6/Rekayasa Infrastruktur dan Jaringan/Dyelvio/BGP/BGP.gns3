            },
            {
                "drawing_id": "c4c473fe-36d4-4752-bf85-405c41fffd96",
                "locked": false,
                "rotation": 0,
                "svg": "<svg width=\"640\" height=\"176\"><text font-family=\"TypeWriter\" font-size=\"10.0\" font-weight=\"bold\" fill=\"#000000\" fill-opacity=\"1.0\">Konfigurasi BGP Dasar:\n1. perkenalan antar tetangga ==&gt; disebut sebagai \"PAIRING NEIGHBOR\"\nrouter bgp &lt;ASN diri sendiri&gt;\nneighbor &lt;IP tetangga&gt; remote-as &lt;ASN tetangga&gt;\n khusus yang pairing loopback (R1 - R2), tambahkan cmd :\nneighbor &lt;IP tetangga&gt; remote-as &lt;ASN tetangga&gt;\n2. daftarkan network ==&gt; disebut sebagai \"ADVERTISE NETWORK\"\nnetwork &lt;network address&gt; mask &lt;subnet mask&gt;</text></svg>",
                "x": -553,
                "y": 187,
                "z": 2
            }
